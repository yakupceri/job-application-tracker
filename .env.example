# Copy this file to .env and fill in real values. .env is gitignored.

# --- Required ---
SECRET_KEY=change-me-to-a-long-random-string
PANEL_USERNAME=admin
PANEL_PASSWORD=change-me

# --- Database ---
# Leave unset in development: falls back to a local SQLite file
# (tracker.DEFAULT_DB_PATH, or DB_PATH below). In production, point this at
# a PostgreSQL database, e.g.:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
DB_PATH=

# --- One-time legacy data migration (see migrations/versions/*_add_user_profile_fields.py) ---
# Used only to backfill the pre-existing owner account (PANEL_USERNAME) with
# the new profile fields the first time this migration runs.
OWNER_EMAIL=
OWNER_FULL_NAME=
OWNER_TARGET_POSITION=
OWNER_CITY=

# --- Optional: SMTP, for email verification + "forgot password" ---
# If MAIL_SERVER is not set, both features stay disabled and the app runs
# normally without them (registration succeeds without verification, and
# the "forgot password" page explains the feature is unavailable).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=
# Public base URL used to build verification/reset links in emails.
APP_BASE_URL=http://localhost:5000
